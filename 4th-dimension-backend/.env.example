PORT=3000
MONGODB_URI=mongodb://localhost:27017/4th-dimension
CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Max primitive payload size stored embedded in MongoDB (default 16MB)
PRIMITIVE_EMBEDDED_MAX_BYTES=16777216

# Rate limiting (Sprint B9)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

# Response caching (Sprint B10)
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_PRIMITIVES_TTL_SECONDS=3600
CACHE_MAX_ITEMS=500
# Skip caching primitive payloads larger than this (defaults to PRIMITIVE_EMBEDDED_MAX_BYTES)
# CACHE_MAX_PRIMITIVE_BYTES=16777216
